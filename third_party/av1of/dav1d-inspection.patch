diff --git a/src/refmvs.h b/src/refmvs.h
index 9e0ed747..5cabbfa3 100644
--- a/src/refmvs.h
+++ b/src/refmvs.h
@@ -158,6 +158,30 @@ static inline void dav1d_refmvs_save_tmvs(const Dav1dRefmvsDSPContext *const dsp
                    col_end8, row_end8, col_start8, row_start8);
 }
 
+#if CONFIG_INSPECTION
+// AV1-Optical-Flow: copy one tile/sbrow's full-resolution 4x4 spatial blocks
+// out of the (transient) refmvs prediction window into a persistent full-frame
+// grid, before the window is overwritten by the next sbrow. Coordinates are in
+// 4-pixel units; the row pointer `(y & 31) + 5` mirrors the splat_mv() writes in
+// decode.c. Single-thread (n_tc == 1) decode path only.
+static inline void dav1d_refmvs_save_inspect(const refmvs_tile *const rt,
+                                             refmvs_block *const dst,
+                                             const ptrdiff_t dst_stride,
+                                             const int col_start4, int col_end4,
+                                             const int row_start4, int row_end4)
+{
+    const refmvs_frame *const rf = rt->rf;
+    row_end4 = imin(row_end4, rf->ih4);
+    col_end4 = imin(col_end4, rf->iw4);
+    for (int y = row_start4; y < row_end4; y++) {
+        const refmvs_block *const src = rt->r[(y & 31) + 5];
+        refmvs_block *const drow = &dst[y * dst_stride];
+        for (int x = col_start4; x < col_end4; x++)
+            drow[x] = src[x];
+    }
+}
+#endif
