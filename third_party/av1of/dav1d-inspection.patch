+/**
+ * Inspection callback data (AV1-Optical-Flow patch, gated by CONFIG_INSPECTION).
+ *
+ * Delivered once per decoded frame, before the decoder releases its internal
+ * motion-vector buffers. `blocks` points at the full-frame 4x4 spatial block
+ * grid (the analogue of AOM inspect's per-MI grid), indexed
+ * `blocks[y * blk_stride + x]` for y in [0, blk_h), x in [0, blk_w). Each record
+ * is a 12-byte packed `refmvs_block`:
+ *
+ *     offset 0:  int16_t mv[0].y, mv[0].x   (list 0 / backward, 1/8-pel)
+ *     offset 4:  int16_t mv[1].y, mv[1].x   (list 1 / forward,  1/8-pel)
+ *     offset 8:  int8_t  ref[0], ref[1]     (1..7 ref slot, 0 = intra, -1 = none)
+ *     offset 10: uint8_t bs                 (enum BlockSize, dav1d ordering)
+ *     offset 11: uint8_t mf                 (mode flags: 1 = globalmv/affine, 2 = newmv)
+ *
+ * `blocks` is NULL for intra/key frames (no motion field). The pointer is only
+ * valid for the duration of the callback; copy out anything you need to keep.
+ */
+typedef struct Dav1dInspectData {
+    unsigned decode_seq;     ///< monotonic decode-order index (for reordering
+                             ///< frames that complete out of order under threading)
+    unsigned frame_offset;   ///< order hint / picture order count of this frame
+    int frame_type;          ///< enum Dav1dFrameType
+    int width, height;       ///< luma dimensions in pixels
+    int blk_w, blk_h;        ///< valid block-grid dimensions, in 4x4 blocks
+    ptrdiff_t blk_stride;    ///< row stride of `blocks`, in 12-byte records
+    const void *blocks;      ///< 4x4 spatial block grid, or NULL (intra)
+    int8_t refidx[7];        ///< reference slot index per ref frame
+    unsigned refpoc[7];      ///< order hint / POC of each reference frame
+} Dav1dInspectData;
+
 typedef struct Dav1dSettings {
     int n_threads; ///< number of threads (0 = number of logical cores in host system, default 0)
     int max_frame_delay; ///< Set to 1 for low-latency decoding (0 = ceil(sqrt(n_threads)), default 0)
@@ -95,6 +126,9 @@ typedef struct Dav1dSettings {
                                                ///< DAV1D_INLOOPFILTER_ALL)
     enum Dav1dDecodeFrameType decode_frame_type; ///< frame types to decode (default
                                                  ///< DAV1D_DECODEFRAMETYPE_ALL)
+    void *inspect_cookie; ///< custom pointer passed to inspect_cb (AV1-Optical-Flow patch)
+    void (*inspect_cb)(void *cookie, const Dav1dInspectData *data); ///< per-frame block
+                          ///< metadata callback; NULL to disable (default NULL)
     uint8_t reserved[16]; ///< reserved for future use
 } Dav1dSettings;
 
